# =====================================
# Gitignore for GameControllerSimulator
# Android / iOS / Windows modules
# =====================================

# ==========================
# Android
# ==========================
# 忽略所有模块下的 build/ 和 bin/ 目录
Android/**/build/
Android/**/bin/
Android/**/obj/

# Gradle/IDE缓存
Android/.gradle/
Android/local.properties

# ==========================
# iOS
# ==========================
# 忽略所有模块下的 build/ 和 DerivedData
iOS/**/build/
iOS/**/DerivedData/

# Xcode 文件缓存
iOS/**/*.xcuserdata
iOS/**/*.xcuserstate
iOS/**/*.xcscmblueprint

# CocoaPods
iOS/Pods/

# ==========================
# Windows
# ==========================
# 忽略所有模块下的 bin/ 和 obj/
Windows/**/bin/
Windows/**/obj/

# VS / WinUI3 / .NET 临时文件
Windows/**/.vs/
Windows/**/*.user
Windows/**/*.suo
Windows/**/*.VC.db
Windows/**/*.VC.opendb
Windows/**/*.pdb

# ==========================
# 通用
# ==========================
# 忽略系统文件
*.DS_Store
Thumbs.db

# 临时编辑器文件
*.swp
*.sublime-workspace
*.sublime-project